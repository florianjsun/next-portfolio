# Copy to /etc/nginx/sites-available/next-portfolio and enable the site.
# Replace example.com with your domain, then issue a certificate with:
#   sudo certbot certonly --webroot -w /var/www/certbot -d example.com \
#     --deploy-hook 'systemctl reload nginx'
#
# This template assumes Cloudflare sits in front of the origin. Drop the
# real-ip include and the $client_scheme map if you serve traffic directly.

# Cloudflare terminates TLS for visitors and re-connects to this origin, so
# $scheme describes Cloudflare's hop, not what the visitor typed.
# X-Forwarded-Proto carries the real client scheme.
map $http_x_forwarded_proto $client_scheme {
    default     $scheme;
    "~*^https$" https;
    "~*^http$"  http;
}

# Advertise HSTS only for requests the visitor actually made over HTTPS.
# An empty value makes nginx omit the header entirely.
map $client_scheme $hsts_value {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

upstream next_portfolio {
    server 127.0.0.1:3000;
    keepalive 64;
}

# Unknown Host (direct IP probes, scanners): close the connection. Keep the
# self-signed certificate here so a port scan of the origin IP cannot read the
# real hostname off the certificate and undo Cloudflare's origin-IP hiding.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    # nginx < 1.25.1 has no standalone `http2 on;` directive.
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/placeholder.crt;
    ssl_certificate_key /etc/nginx/ssl/placeholder.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Generated by deploy/update-cloudflare-ips.sh. Without it every client IP
    # in the logs is a Cloudflare edge address.
    include /etc/nginx/snippets/cloudflare-realip.conf;

    client_max_body_size 1m;
    server_tokens off;

    # ACME must answer on both ports: which one Cloudflare uses to reach the
    # origin depends on its SSL/TLS mode, and renewals have to work either way.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    location / {
        # Upgrade plain-HTTP visitors, but never bounce a request that already
        # arrived over HTTPS at the edge: that loops forever in Flexible mode.
        if ($client_scheme = http) {
            return 301 https://$host$request_uri;
        }

        proxy_pass http://next_portfolio;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        add_header Strict-Transport-Security $hsts_value always;
    }
}
