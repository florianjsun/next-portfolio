# FormSubmit form id from the activation email. Leave empty to use the
# default hash wired for portfolio.sunnao.wtf/contact.
FORMSUBMIT_ID=

# Optional Google Forms override. If all five are set, submissions go there
# instead of the default email inbox.
GOOGLE_FORM_LINK=
GOOGLE_FORM_FIELD_ID_NAME=
GOOGLE_FORM_FIELD_ID_EMAIL=
GOOGLE_FORM_FIELD_ID_MESSAGE=
GOOGLE_FORM_FIELD_ID_SOCIAL=

# Public origin used for canonical URLs, sitemap and Open Graph.
# Leave empty to fall back to the default in config/site.ts.
NEXT_PUBLIC_SITE_URL=

# Google Analytics
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console site verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Resume Link
NEXT_PUBLIC_RESUME_LINK=your_resume_link

# Notion Blog (server-only; never prefix these secrets with NEXT_PUBLIC_)
# NOTION_TOKEN uses the ntn_... value from your internal connection.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_WEBHOOK_LOG_VERIFICATION_TOKEN=false
NOTION_BLOG_REVALIDATE_SECONDS=900

# GitHub contributions (server-only; token is optional but raises rate limits)
GITHUB_USERNAME=florianjsun
GITHUB_TOKEN=
